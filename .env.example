# Copy to .env and adjust. docker-compose reads JWT_SECRET / SEED_ADMIN_* from here.

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://queue:queue@localhost:5432/queue
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

TOKEN_PREFIX=A
KIOSK_RESET_SECONDS=20

SMS_PROVIDER=console
SMS_MAX_ATTEMPTS=3
PUBLIC_QUEUE_URL=http://localhost:5173/display

# Only needed when SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

PREDICTION_SERVICE_URL=http://localhost:8001
PREDICTION_TIMEOUT_SECONDS=1.5

CORS_ORIGINS=["http://localhost:5173"]

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/queue
